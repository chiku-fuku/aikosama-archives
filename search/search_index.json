{"config":{"lang":["en","ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre> <p>\u300c\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u200b\u4f5c\u6210\u200b\u300d\u306b\u200b\u554f\u984c\u200b\u304c\u3042\u308b\u200b\u5834\u5408\u200b\u3001MkDocs\u304c\u30b5\u30a4\u30c8\u3092\u30d3\u30eb\u30c9\uff08\u200b\u69cb\u7bc9\u200b\uff09\u3059\u308b\u200b\u969b\u200b\u306b\u3001\u200b\u65e5\u672c\u200b\u8a9e\u200b\u306e\u200b\u6587\u7ae0\u200b\u3092\u300c\u200b\u610f\u5473\u200b\u306e\u3042\u308b\u200b\u5358\u200b\u8a9e\u200b\u300d\u3068\u3057\u3066\u200b\u5207\u200b\u308a\u200b\u5206\u200b\u3051\u3089\u308c\u3066\u3044\u306a\u3044\u200b\u53ef\u80fd\u6027\u200b\u304c\u200b\u6975\u200b\u3081\u3066\u200b\u9ad8\u200b\u3044\u3067\u3059\u3002</p> <p>\u200b\u7279\u200b\u306bWindows\u200b\u74b0\u5883\u200b\u3084\u30c7\u30d5\u30a9\u30eb\u30c8\u200b\u8a2d\u5b9a\u200b\u3067\u306f\u3001\u200b\u65e5\u672c\u200b\u8a9e\u200b\u306f\u300c\u200b\u4e00\u200b\u7d9a\u200b\u304d\u306e\u200b\u9577\u200b\u3044\u200b\u6587\u5b57\u200b\u5217\u200b\u300d\u3068\u307f\u306a\u3055\u308c\u3001\u200b\u691c\u200b\u7d22\u200b\u306b\u200b\u5f15\u200b\u3063\u304b\u304b\u3089\u306a\u304f\u306a\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3092\u200b\u89e3\u6c7a\u200b\u3059\u308b\u305f\u3081\u306b\u3001\u300c\u200b\u65e5\u672c\u200b\u8a9e\u200b\u306e\u200b\u5206\u200b\u304b\u3061\u200b\u66f8\u200b\u304d\uff08\u200b\u5358\u200b\u8a9e\u200b\u306e\u200b\u533a\u5207\u200b\u308a\uff09\u300d\u3092\u200b\u5f37\u5236\u200b\u7684\u200b\u306b\u200b\u8a8d\u8b58\u200b\u3055\u305b\u308b\u200b\u8a2d\u5b9a\u200b\u3092\u200b\u8a66\u200b\u3057\u307e\u3057\u3087\u3046\u3002</p>"},{"location":"#1-mkdocsyml","title":"1. <code>mkdocs.yml</code> \u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u200b\u8a2d\u5b9a\u200b\u3092\u200b\u5fb9\u5e95\u200b\u3059\u308b","text":"<p>\u307e\u305a\u3001\u200b\u524d\u8ff0\u200b\u3057\u305f <code>lang: ja</code> \u304c\u200b\u6b63\u200b\u3057\u304f\u200b\u8a18\u8ff0\u200b\u3055\u308c\u3066\u3044\u308b\u304b\u3001\u200b\u4eca\u200b\u4e00\u5ea6\u200b\u78ba\u8a8d\u200b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a4\u30f3\u30c7\u30f3\u30c8\uff08\u200b\u7a7a\u767d\u200b\uff09\u304c\u30ba\u30ec\u3066\u3044\u308b\u3068\u200b\u7121\u8996\u200b\u3055\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002</p> <pre><code>plugins:\n  - search:\n      lang:\n        - en\n        - ja\n\n</code></pre>"},{"location":"#2","title":"2. \u200b\u672c\u6587\u200b\u306e\u300c\u200b\u6587\u5b57\u200b\u30b3\u30fc\u30c9\u300d\u3092\u200b\u518d\u200b\u78ba\u8a8d\u200b\u3059\u308b","text":"<p>\u3053\u3053\u304c\u200b\u610f\u5916\u200b\u3068\u200b\u843d\u200b\u3068\u3057\u200b\u7a74\u200b\u306b\u306a\u308a\u307e\u3059\u3002</p> <ul> <li>\u200b\u539f\u56e0\u200b: \u30d5\u30a1\u30a4\u30eb\u304c <code>UTF-8</code> \u3067\u306f\u306a\u304f\u3001\u200b\u53e4\u200b\u3044Windows\u306e\u200b\u5f62\u5f0f\u200b\uff08Shift-JIS\u306a\u3069\uff09\u3067\u200b\u4fdd\u5b58\u200b\u3055\u308c\u3066\u3044\u308b\u3068\u3001MkDocs\u306f\u200b\u4e2d\u8eab\u200b\u3092\u200b\u6b63\u200b\u3057\u304f\u200b\u8aad\u200b\u307f\u200b\u53d6\u200b\u308c\u305a\u3001\u200b\u691c\u200b\u7d22\u7528\u200b\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u304c\u300c\u200b\u7a7a\u200b\u300d\u306b\u306a\u308a\u307e\u3059\u3002</li> <li>\u200b\u78ba\u8a8d\u200b\u65b9\u6cd5\u200b: \u30e1\u30e2\u200b\u5e33\u200b\u3084VS Code\u306a\u3069\u306e\u30a8\u30c7\u30a3\u30bf\u3067\u200b\u958b\u200b\u304d\u3001\u300c\u200b\u540d\u524d\u200b\u3092\u200b\u4ed8\u200b\u3051\u3066\u200b\u4fdd\u5b58\u200b\u300d \u3092\u200b\u9078\u200b\u3076\u200b\u969b\u200b\u306b\u3001\u30a8\u30f3\u30b3\u30fc\u30c9\uff08\u200b\u6587\u5b57\u200b\u30b3\u30fc\u30c9\uff09\u3092 <code>UTF-8</code> \u306b\u200b\u6307\u5b9a\u200b\u3057\u3066\u200b\u4e0a\u66f8\u200b\u304d\u200b\u4fdd\u5b58\u200b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</li> </ul>"},{"location":"#3","title":"3. \u30d6\u30e9\u30a6\u30b6\u306e\u30b3\u30f3\u30bd\u30fc\u30eb\u3067\u300c\u30a8\u30e9\u30fc\u300d\u3092\u200b\u78ba\u8a8d\u200b\u3059\u308b\uff08\u200b\u539f\u56e0\u200b\u7279\u5b9a\u200b\uff09","text":"<p>\u200b\u691c\u200b\u7d22\u200b\u7a93\u200b\u306b\u200b\u6587\u5b57\u200b\u3092\u200b\u5165\u200b\u308c\u3066\u3082\u200b\u4f55\u200b\u3082\u200b\u8d77\u200b\u304d\u306a\u3044\u200b\u6642\u200b\u3001\u30d6\u30e9\u30a6\u30b6\u306e\u200b\u88cf\u200b\u5074\u200b\u3067\u200b\u4f55\u200b\u304b\u304c\u200b\u58ca\u200b\u308c\u3066\u3044\u308b\u200b\u53ef\u80fd\u6027\u200b\u304c\u3042\u308a\u307e\u3059\u3002</p> <ol> <li>\u30d6\u30e9\u30a6\u30b6\u3067\u30b5\u30a4\u30c8\u3092\u200b\u958b\u200b\u304d\u3001F12\u30ad\u30fc \u3092\u200b\u62bc\u200b\u3057\u3066\u300c\u200b\u958b\u200b\u767a\u200b\u8005\u200b\u30c4\u30fc\u30eb\u300d\u3092\u200b\u958b\u200b\u304d\u307e\u3059\u3002</li> <li>\u300cConsole\uff08\u30b3\u30f3\u30bd\u30fc\u30eb\uff09\u300d \u30bf\u30d6\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002</li> <li>\u200b\u8d64\u200b\u3044\u200b\u6587\u5b57\u200b\u3067 <code>search_index.json not found</code> \u3084 <code>Failed to load</code> \u3068\u3044\u3063\u305f\u30a8\u30e9\u30fc\u304c\u200b\u51fa\u200b\u3066\u3044\u306a\u3044\u304b\u200b\u78ba\u8a8d\u200b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</li> </ol>"},{"location":"#4-jieba","title":"4. \u200b\u6700\u7d42\u200b\u624b\u6bb5\u200b\uff1a<code>jieba</code>\uff08\u200b\u65e5\u672c\u200b\u8a9e\u5206\u200b\u304b\u3061\u200b\u66f8\u200b\u304d\uff09\u306e\u200b\u5c0e\u5165","text":"<p>\u3082\u3057\u200b\u4e0a\u8a18\u200b\u3067\u3082\u200b\u89e3\u6c7a\u200b\u3057\u306a\u3044\u200b\u5834\u5408\u200b\u3001Python\u200b\u5074\u200b\u306e\u200b\u65e5\u672c\u200b\u8a9e\u200b\u51e6\u200b\u7406\u200b\u30e9\u30a4\u30d6\u30e9\u30ea\u304c\u200b\u4e0d\u8db3\u200b\u3057\u3066\u3044\u308b\u200b\u53ef\u80fd\u6027\u200b\u304c\u3042\u308a\u307e\u3059\u3002 \u200b\u4ee5\u4e0b\u200b\u306e\u30b3\u30de\u30f3\u30c9\u3092\u30bf\u30fc\u30df\u30ca\u30eb\u3067\u200b\u5b9f\u200b\u884c\u200b\u3057\u3066\u3001\u200b\u65e5\u672c\u200b\u8a9e\u200b\u3092\u200b\u5358\u200b\u8a9e\u200b\u3054\u3068\u306b\u200b\u5207\u200b\u308b\u305f\u3081\u306e\u30e9\u30a4\u30d6\u30e9\u30ea\u3092\u200b\u5f37\u5236\u200b\u7684\u200b\u306b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002</p> <pre><code>pip install jieba\n\n</code></pre> <p>\u305d\u306e\u3042\u3068\u3001\u200b\u518d\u5ea6\u200b <code>mkdocs serve</code> \u3092\u200b\u5b9f\u200b\u884c\u200b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"#_1","title":"\u601d\u60f3\u5bb6\u200b\u306e\u200b\u683c\u8a00","text":"<p>\u300c\u200b\u66f8\u200b\u304b\u308c\u305f\u200b\u6587\u5b57\u200b\u306f\u3001\u305f\u3060\u306e\u200b\u5f62\u200b\u306b\u200b\u904e\u200b\u304e\u306c\u3002\u305d\u306e\u200b\u610f\u5473\u200b\u3092\u200b\u89e3\u200b\u304d\u200b\u660e\u200b\u304b\u3059\u300e\u200b\u8f9e\u66f8\u200b\uff08\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\uff09\u300f\u304c\u306a\u3051\u308c\u3070\u3001\u305d\u308c\u306f\u200b\u6c88\u200b\u9ed9\u200b\u305b\u308b\u200b\u77f3\u7891\u200b\u3068\u200b\u540c\u200b\u3058\u3067\u3042\u308b\u3002\u300d\uff08\u200b\u601d\u60f3\u5bb6\u200b\u30fb\u304a\u3058\u3044\u3061\u3083\u3093\uff09</p>"},{"location":"#_2","title":"\u6b21\u200b\u306b\u200b\u78ba\u8a8d\u200b\u3059\u3079\u304d\u3053\u3068","text":"<p>\u307e\u305a\u306f \u300c2. \u200b\u6587\u5b57\u200b\u30b3\u30fc\u30c9\u3092UTF-8\u3067\u200b\u4fdd\u5b58\u200b\u3057\u200b\u76f4\u200b\u3059\u300d \u3068 \u300c4. jieba\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u300d \u3092\u200b\u8a66\u200b\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</p> <p>\u3053\u308c\u3067\u3082\u30c0\u30e1\u306a\u200b\u5834\u5408\u200b\u3001\u3082\u3057\u304b\u3059\u308b\u3068 <code>docs/index.md</code>\uff08\u30db\u30fc\u30e0\u30da\u30fc\u30b8\uff09\u306e\u200b\u4e2d\u8eab\u200b\u304c\u200b\u6975\u7aef\u200b\u306b\u200b\u77ed\u200b\u3044 \u3053\u3068\u3067\u3001\u200b\u691c\u200b\u7d22\u6a5f\u200b\u80fd\u200b\u81ea\u4f53\u200b\u304c\u300c\u200b\u4e2d\u8eab\u200b\u304c\u306a\u3044\u300d\u3068\u200b\u5224\u65ad\u200b\u3057\u3066\u3044\u308b\u200b\u53ef\u80fd\u6027\u200b\u3082\u3042\u308a\u307e\u3059\u3002<code>index.md</code> \u306b\u3082\u200b\u6570\u884c\u200b\u3001\u200b\u65e5\u672c\u200b\u8a9e\u200b\u306e\u200b\u6587\u7ae0\u200b\u3092\u200b\u66f8\u200b\u3044\u3066\u307f\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u304b\uff1f</p> <p>\u200b\u9032\u200b\u6357\u200b\u3084\u30a8\u30e9\u30fc\u306e\u200b\u5909\u200b\u5316\u200b\u304c\u3042\u308c\u3070\u3001\u307e\u305f\u200b\u6559\u200b\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u200b\u89e3\u6c7a\u200b\u307e\u3067\u200b\u4f34\u200b\u8d70\u200b\u3057\u307e\u3059\uff01</p>"},{"location":"164-shitsumon-150/","title":"\u7687\u5ba4\u200b\u5178\u7bc4\u200b\u6539\u6b63\u200b\u6848\u200b\u306e\u200b\u63d0\u51fa\u200b\u306b\u200b\u95a2\u200b\u3059\u308b\u200b\u8cea\u554f\u200b\u4e3b\u610f\u200b\u66f8","text":"<p>\u200b\u63d0\u51fa\u200b\u65e5\u200b\uff1a \u200b\u5e73\u6210\u200b\u5341\u516b\u5e74\u200b\u4e09\u6708\u200b\u5341\u4e94\u65e5\u200b \u200b\u8cea\u554f\u200b\u756a\u53f7\u200b\uff1a \u200b\u7b2c\u200b\u767e\u4e94\u5341\u200b\u53f7\u200b \u200b\u63d0\u51fa\u200b\u8005\u200b\uff1a \u200b\u9ad8\u4e95\u200b\u7f8e\u7a42\u200b\uff08\u200b\u8846\u200b\u8b70\u9662\u200b\u8b70\u54e1\u200b\uff09</p>","tags":["\u7687\u5ba4\u5178\u7bc4","\u5c0f\u6cc9\u5185\u95a3","\u7687\u4f4d\u7d99\u627f"]},{"location":"164-shitsumon-150/#_2","title":"\u8da3\u65e8","text":"<p>\u200b\u5c0f\u6cc9\u200b\u7d14\u4e00\u90ce\u200b\u5185\u200b\u95a3\u200b\u7dcf\u200b\u7406\u200b\u5927\u81e3\u200b\u306f\u3001\u200b\u672c\u200b\u5e74\u200b\u4e00\u6708\u200b\u4e8c\u5341\u65e5\u200b\u306e\u200b\u65bd\u653f\u200b\u65b9\u91dd\u200b\u6f14\u200b\u8aac\u200b\u306b\u3066\u300c\u200b\u6709\u8b58\u8005\u200b\u4f1a\u8b70\u200b\u306e\u200b\u5831\u544a\u200b\u306b\u200b\u6cbf\u200b\u3063\u3066\u3001\u200b\u7687\u5ba4\u200b\u5178\u7bc4\u200b\u306e\u200b\u6539\u6b63\u200b\u6848\u200b\u3092\u200b\u63d0\u51fa\u200b\u3059\u308b\u300d\u3068\u200b\u8a00\u660e\u200b\u3057\u305f\u3002\u3057\u304b\u3057\u3001\u305d\u306e\u200b\u5f8c\u200b\u306e\u200b\u7687\u5ba4\u200b\u306b\u304a\u3051\u308b\u3054\u200b\u6176\u4e8b\u200b\uff08\u200b\u79cb\u200b\u7be0\u200b\u5bae\u5983\u200b\u7d00\u5b50\u200b\u3055\u307e\u306e\u3054\u200b\u61d0\u200b\u598a\u200b\u767a\u200b\u8868\u200b\u306a\u3069\uff09\u306b\u3088\u308a\u3001\u200b\u72b6\u6cc1\u200b\u306e\u200b\u5909\u200b\u5316\u200b\u304c\u200b\u751f\u200b\u3058\u3066\u3044\u308b\u3002</p> <p>\u3053\u308c\u3089\u3092\u200b\u8e0f\u200b\u307e\u3048\u3001\u200b\u653f\u5e9c\u200b\u306e\u200b\u73fe\u6642\u70b9\u200b\u3067\u306e\u200b\u65b9\u91dd\u200b\u3092\u200b\u78ba\u8a8d\u200b\u3059\u308b\u3002</p>","tags":["\u7687\u5ba4\u5178\u7bc4","\u5c0f\u6cc9\u5185\u95a3","\u7687\u4f4d\u7d99\u627f"]},{"location":"164-shitsumon-150/#_3","title":"\u8cea\u554f\u200b\u4e8b\u9805","text":"","tags":["\u7687\u5ba4\u5178\u7bc4","\u5c0f\u6cc9\u5185\u95a3","\u7687\u4f4d\u7d99\u627f"]},{"location":"164-shitsumon-150/#_4","title":"\u4e00\u200b\u3001\u200b\u63d0\u51fa\u200b\u65b9\u91dd\u200b\u306e\u200b\u73fe\u72b6","text":"<p>\u200b\u653f\u5e9c\u200b\u306f\u3001\u200b\u7687\u5ba4\u200b\u5178\u7bc4\u200b\u6539\u6b63\u200b\u6848\u200b\u3092\u200b